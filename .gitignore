# Dependencies
node_modules/
.pnp/
.pnp.js

# Build outputs
.next/
out/
build/
dist/

# Environment files (NEVER commit these!)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
# nano's emergency save (`<file>.save`) when it is killed mid-edit — a plaintext
# copy of whatever was open, so on the server that means the production .env.
# `.env` above is an exact-name match and does NOT cover `.env.save`.
*.save

# Secrets / service-account credentials (NEVER commit these!)
gmail-sa.json
backend/gmail-sa.json
*-sa.json

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE / Editor
.idea/
.vscode/
*.swp
*.swo

# OS files
