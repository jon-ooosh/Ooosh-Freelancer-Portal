# Dependencies
node_modules/
.pnp/
.pnp.js

# Build outputs
.next/
out/
build/
dist/
# frontend build-in-progress and previous build (deploy/build-frontend.sh)
dist-new/
dist-prev/

# Environment files (NEVER commit these!)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
# nano's emergency save (`<file>.save`) when it is killed mid-edit — a plaintext
# copy of whatever was open, so on the server that means the production .env.
# `.env` above is an exact-name match and does NOT cover `.env.save`.
*.save
# Hand-made backups of the .env (`.env.bak-20261022` sat untracked on the
# server for two weeks, Nov 2026) — same risk: a `git add -A` commits secrets.
.env.bak*
*.env.bak*

# Secrets / service-account credentials (NEVER commit these!)
gmail-sa.json
backend/gmail-sa.json
*-sa.json

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE / Editor
.idea/
.vscode/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Netlify
.netlify/
